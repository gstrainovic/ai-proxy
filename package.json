{
  "name": "@strainovic/ai-proxy",
  "version": "0.2.0",
  "description": "AI-Proxy: hält den Mistral-Key, zählt Nutzung pro Nutzer und Monat, setzt Plan-Limits durch, Stripe-Abos. Hono, läuft auf Node und in Supabase Edge Functions.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Goran Strainovic, Strainovic IT",
  "repository": "github:gstrainovic/ai-proxy",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ai-proxy": "./src/node.ts"
  },
  "exports": {
    ".": "./src/app.ts",
    "./auth/instant": "./src/auth/instant.ts",
    "./auth/supabase": "./src/auth/supabase.ts",
    "./billing": "./src/billing.ts",
    "./camt": "./src/camt.ts",
    "./config": "./src/config.ts",
    "./edge": "./src/edge.ts",
    "./invoice": "./src/invoice.ts",
    "./invoice-mail": "./src/invoice-mail.ts",
    "./invoice-pdf": "./src/invoice-pdf.ts",
    "./invoice-subscription": "./src/invoice-subscription.ts",
    "./limits": "./src/limits.ts",
    "./plans": "./src/plans.ts",
    "./stores/instant": "./src/stores/instant.ts",
    "./stores/memory": "./src/stores/memory.ts",
    "./stores/supabase": "./src/stores/supabase.ts",
    "./stores/types": "./src/stores/types.ts",
    "./trial": "./src/trial.ts"
  },
  "files": [
    "src",
    "Dockerfile",
    "README.md",
    "LICENSE",
    "deno.json"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env src/node.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "test:deno": "deno check src/edge.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@instantdb/admin": "0.22.121",
    "@supabase/supabase-js": "^2.115.0",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.7",
    "pdfkit": "^0.20.2",
    "stripe": "^22.6.1",
    "swissqrbill": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@types/pdfkit": "^0.17.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
