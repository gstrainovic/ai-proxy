# Mistral (Plattform-Key, wird nie an den Client gegeben)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Backend: genau eines von beiden konfigurieren.
# a) InstantDB (auto-service): Store für Zähler/Abos und Token-Prüfung
INSTANT_API_URI=http://localhost:8888
INSTANT_APP_ID=
INSTANT_ADMIN_TOKEN=
# b) Supabase (dms): Tabellen ai_usage/ai_subscriptions, JWT-Prüfung via auth.getUser
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=8787
CORS_ORIGIN=*
APP_URL=http://localhost:5173
# Nur lokal/E2E: User-ID aus Header x-user-id ohne Token akzeptieren. NIE in Produktion.
AI_PROXY_AUTH_BYPASS=

# Stripe (leer = Zahlung nicht konfiguriert, Billing-Endpunkte antworten 501)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
